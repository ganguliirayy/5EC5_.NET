using System;
using System.Collections.Generic;

// Custom Exception - invalid amount entered
class InvalidAmountException : Exception
{
    public InvalidAmountException(string message) : base(message) { }
}

// Custom Exception - budget limit exceeded
class BudgetExceededException : Exception
{
    public BudgetExceededException(string message) : base(message) { }
}

class Expense
{
    // Private data members
    private int expenseId;
    private string category;
    private double amount;
    private string date;

    // Constructor
    public Expense(int id, string cat, double amt, string dt)
    {
        expenseId = id;
        category = cat;
        amount = amt;
        date = dt;
    }

    // Properties for safe access
    public int ExpenseId { get { return expenseId; } }
    public string Category { get { return category; } }
    public double Amount { get { return amount; } }
    public string Date { get { return date; } }

    public void Display()
    {
        Console.WriteLine(
            "ID: " + expenseId +
            "\tCategory: " + category +
            "\tAmount: Rs. " + amount +
            "\tDate: " + date
        );
    }
}

class ExpenseTracker
{
    private List<Expense> expenseList = new List<Expense>();
    private double monthlyBudget;
    private double totalSpent = 0;

    public ExpenseTracker(double budget)
    {
        monthlyBudget = budget;
    }

    // Adds expense with validation and exception handling
    public void AddExpense(int id, string category, double amount, string date)
    {
        try
        {
            if (amount <= 0)
            {
                throw new InvalidAmountException("Amount must be greater than zero.");
            }

            if ((totalSpent + amount) > monthlyBudget)
            {
                throw new BudgetExceededException(
                    "Adding this expense will exceed your monthly budget of Rs. " + monthlyBudget
                );
            }

            Expense newExpense = new Expense(id, category, amount, date);
            expenseList.Add(newExpense);
            totalSpent += amount;

            Console.WriteLine("\nExpense added successfully!");
        }
        catch (InvalidAmountException ex)
        {
            Console.WriteLine("\n[Invalid Amount] " + ex.Message);
        }
        catch (BudgetExceededException ex)
        {
            Console.WriteLine("\n[Budget Alert] " + ex.Message);
        }
        catch (Exception ex)
        {
            Console.WriteLine("\n[Unexpected Error] " + ex.Message);
        }
        finally
        {
            Console.WriteLine("Attempt to add expense completed.\n");
        }
    }

    public void ShowExpenses()
    {
        Console.WriteLine("\n================ EXPENSE REPORT ================");

        if (expenseList.Count == 0)
        {
            Console.WriteLine("No expenses recorded yet.");
        }
        else
        {
            foreach (Expense e in expenseList)
            {
                e.Display();
            }
        }

        Console.WriteLine("--------------------------------------------------");
        Console.WriteLine("Monthly Budget : Rs. " + monthlyBudget);
        Console.WriteLine("Total Spent    : Rs. " + totalSpent);
        Console.WriteLine("Balance Left   : Rs. " + (monthlyBudget - totalSpent));
        Console.WriteLine("==================================================");
    }
}

class Program
{
    static void Main(string[] args)
    {
        Console.WriteLine("====================================================");
        Console.WriteLine("               MARWADI UNIVERSITY");
        Console.WriteLine("            EXPENSE TRACKING MODULE");
        Console.WriteLine("====================================================");

        double budget = 0;
        bool validBudget = false;

        // Validate budget input before proceeding
        while (!validBudget)
        {
            try
            {
                Console.Write("\nEnter Monthly Budget : Rs. ");
                budget = Convert.ToDouble(Console.ReadLine());

                if (budget <= 0)
                {
                    Console.WriteLine("Budget must be greater than zero. Try again.");
                    continue;
                }

                validBudget = true;
            }
            catch (FormatException)
            {
                Console.WriteLine("Invalid input. Please enter a numeric value.");
            }
        }

        ExpenseTracker tracker = new ExpenseTracker(budget);

        int choice = 0; // initialized to avoid unassigned variable error
        int nextId = 1;

        do
        {
            Console.WriteLine("\n---------------- MENU ----------------");
            Console.WriteLine("1. Add Expense");
            Console.WriteLine("2. View Expense Report");
            Console.WriteLine("3. Exit");
            Console.Write("Enter Choice : ");

            try
            {
                choice = Convert.ToInt32(Console.ReadLine());
            }
            catch (FormatException)
            {
                Console.WriteLine("Invalid input! Please enter a number (1-3).");
                continue;
            }

            switch (choice)
            {
                case 1:
                    try
                    {
                        Console.Write("Enter Category (Food/Travel/Books/etc) : ");
                        string category = Console.ReadLine();

                        Console.Write("Enter Amount : ");
                        double amount = Convert.ToDouble(Console.ReadLine());

                        Console.Write("Enter Date (dd/mm/yyyy) : ");
                        string date = Console.ReadLine();

                        tracker.AddExpense(nextId, category, amount, date);
                        nextId++;
                    }
                    catch (FormatException)
                    {
                        Console.WriteLine("\nInvalid amount format. Please enter a numeric value.\n");
                    }
                    break;

                case 2:
                    tracker.ShowExpenses();
                    break;

                case 3:
                    Console.WriteLine("\nExiting... Thank you for using Expense Tracker!");
                    break;

                default:
                    Console.WriteLine("\nInvalid choice. Please select 1, 2, or 3.");
                    break;
            }

        } while (choice != 3);

        Console.WriteLine("\nPress any key to exit...");
        Console.ReadKey();
    }
}
