<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Feedback Management</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f7;
            color: #333;
        }

        .navbar {
            background: #173f5f;
            color: white;
            padding: 15px 45px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .nav a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
        }

        .container {
            width: 950px;
            max-width: 92%;
            margin: 30px auto;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 8px;
            box-shadow: 0 2px 8px #ccc;
        }

        .button {
            display: inline-block;
            padding: 9px 15px;
            background: #24527a;
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .success {
            color: #198754;
        }

        .error {
            color: #d32f2f;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <div class="navbar">

        <div class="logo">
            Feedback Management
        </div>

        <div class="nav">
            @Html.ActionLink("Home", "Index", "Feedback")
            @Html.ActionLink("Give Feedback", "Create", "Feedback")
        </div>

    </div>

    <div class="container">
        @RenderBody()
    </div>

</body>
</html>