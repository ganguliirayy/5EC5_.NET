@model List<lab_7.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Management";
}

<div class="container">

    <h1>Feedback Management</h1>

    <div class="top-bar">
        <a asp-action="Create" class="btn">Add Feedback</a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        foreach (var feedback in Model)
        {
            <partial name="_FeedbackCard" model="feedback" />
        }
    }
    else
    {
        <div class="empty">
            No feedback available.
        </div>
    }

</div>

<style>
    .container {
        width: 850px;
        margin: 40px auto;
        font-family: Arial;
    }

    h1 {
        text-align: center;
        color: #24527a;
    }

    .top-bar {
        text-align: right;
        margin-bottom: 20px;
    }

    .btn {
        background: #24527a;
        color: white;
        padding: 10px 18px;
        text-decoration: none;
        border-radius: 5px;
    }

    .empty {
        text-align: center;
        padding: 30px;
        background: #f5f5f5;
    }
</style>