@model List<lab_7.Models.Feedback>

@{
    ViewData["Title"] = "Feedback";
}

<div class="card">

    <h1 style="color:#24527a;">
        Feedback Management
    </h1>

    <p>
        View feedback submitted by users.
    </p>

    @Html.ActionLink(
    "Give Feedback",
        "Create",
        "Feedback",
        null,
        new { @class = "button" }
        )

</div>

<div style="margin-top:20px;">

    @if (Model.Count == 0)
    {
        <div class="card">
            <p>No feedback available.</p>
        </div>
    }
    else
    {
        foreach (var feedback in Model)
        {
            @await Html.PartialAsync(
            "_FeedbackCard",
        feedback
        )
        }
    }

</div>