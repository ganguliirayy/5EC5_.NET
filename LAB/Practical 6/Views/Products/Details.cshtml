@model lab_6.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<!DOCTYPE html>
<html>
<head>
    <title>Product Details</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f7;
        }

        .navbar {
            background: #173f5f;
            color: white;
            padding: 15px 45px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .nav a {
            color: white;
            text-decoration: none;
            padding: 9px 15px;
            margin-left: 7px;
            border-radius: 4px;
        }

        .home {
            background: #286090;
        }

        .add {
            background: #198754;
        }

        .container {
            width: 650px;
            max-width: 92%;
            margin: 50px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 2px 10px #ccc;
        }

        h1 {
            margin-top: 0;
            color: #24527a;
        }

        .category {
            color: #666;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .info {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .description {
            margin-top: 18px;
            line-height: 1.6;
            color: #444;
        }

        .price {
            font-size: 25px;
            font-weight: bold;
            color: #24527a;
            margin: 20px 0;
        }

        .button {
            display: inline-block;
            background: #24527a;
            color: white;
            padding: 10px 16px;
            text-decoration: none;
            border-radius: 4px;
        }
    </style>
</head>

<body>

    <div class="navbar">

        <div class="logo">
            Product Catalog
        </div>

        <div class="nav">
            <a class="home"
               href="@Url.Action("Index", "Products")">
                Home
            </a>

            <a class="add"
               href="@Url.Action("Add", "Products")">
                + Add Product
            </a>
        </div>

    </div>


    <div class="container">

        <div class="card">

            <h1>@Model.Name</h1>

            <div class="category">
                Category: @Model.Category
            </div>

            <div class="info">
                <b>Product ID:</b> @Model.ProductId
            </div>

            <div class="description">
                <b>Description:</b>
                <p>@Model.Description</p>
            </div>

            <div class="price">
                Rs. @Model.Price.ToString("N0")
            </div>

            <a class="button"
               href="@Url.Action("Index", "Products")">
                ← Back to Catalog
            </a>

        </div>

    </div>

</body>
</html>