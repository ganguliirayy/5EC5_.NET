@model List<lab_6.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f7;
        }

        .navbar {
            background: #173f5f;
            color: white;
            padding: 15px 45px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .nav a {
            color: white;
            text-decoration: none;
            padding: 9px 15px;
            margin-left: 7px;
            border-radius: 4px;
        }

        .home {
            background: #286090;
        }

        .add {
            background: #198754;
        }

        .container {
            width: 1000px;
            max-width: 92%;
            margin: 30px auto;
        }

        .header {
            background: #24527a;
            color: white;
            text-align: center;
            padding: 24px;
            border-radius: 8px;
        }

            .header h1 {
                margin: 0;
            }

            .header p {
                margin-bottom: 0;
            }

        .products {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 25px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px #ccc;
        }

        .category {
            color: #24527a;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .name {
            font-size: 20px;
            font-weight: bold;
            margin: 8px 0;
        }

        .description {
            color: #555;
            line-height: 1.5;
            min-height: 72px;
        }

        .price {
            font-size: 18px;
            font-weight: bold;
            margin: 15px 0;
        }

        .details {
            display: inline-block;
            background: #24527a;
            color: white;
            text-decoration: none;
            padding: 9px 15px;
            border-radius: 4px;
        }
    </style>
</head>

<body>

    <div class="navbar">

        <div class="logo">
            Product Catalog
        </div>

        <div class="nav">
            <a class="home"
               href="@Url.Action("Index", "Products")">
                Home
            </a>

            <a class="add"
               href="@Url.Action("Add", "Products")">
                + Add Product
            </a>
        </div>

    </div>


    <div class="container">

        <div class="header">
            <h1>Product Catalog</h1>
            <p>Laptop | Mobile | Headphones</p>
        </div>


        <div class="products">

            @foreach (var product in Model)
            {
                <div class="card">

                    <div class="category">
                        @product.Category
                    </div>

                    <div class="name">
                        @product.Name
                    </div>

                    <div class="description">
                        @product.Description
                    </div>

                    <div class="price">
                        Rs. @product.Price.ToString("N0")
                    </div>

                    <a class="details"
                       href="@Url.Action("Details", "Products",
                                              new { id = product.ProductId })">
                    View Details
                </a>

                </div>
                        }

        </div>

    </div>

</body>
</html>